# Copiá este archivo a `.env.db` (en la raíz; git lo ignora) y completá la clave. Lo leen el bot, la estación y el runner de migrations.
# La base es ClickHouse: la de db/docker/docker-compose.yml o la de tu servidor.
MUBOT_DB_URL=http://127.0.0.1:8123
MUBOT_DB_USER=mubot
MUBOT_DB_PASSWORD=cambiame
# La base del Slow (por defecto mubot_slow). `bun run db:migrate` la crea si falta.
MUBOT_DB_NAME=mubot_slow
