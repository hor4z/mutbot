{
  "name": "mubot",
  "private": true,
  "type": "module",
  "scripts": {
    "bot": "bun run headless-bot.ts",
    "proxy": "bun run proxy.ts",
    "db:up": "docker compose --env-file .env.db -f db/docker-compose.yml up -d",
    "db:init": "bun --env-file=.env.db scripts/db.ts init",
    "aprender": "bun --env-file=.env.db scripts/aprender.ts",
    "tsc": "tsc --noEmit",
    "extract": "bun run extract-packets.ts",
    "estacion": "bun run estacion.ts",
    "ui:build": "vite build --config ui/vite.config.ts",
    "ui:dev": "vite --config ui/vite.config.ts",
    "ui:maps": "python3 ui/scripts/import-maps.py"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "typescript": "5.8.3",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource/geist": "^5.3.0",
    "@fontsource/geist-mono": "^5.3.0",
    "lucide-react": "^1.55.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1"
  }
}
