{
  "name": "mubot",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "tsc": "bun run --filter '*' tsc",
    "estacion": "bun run --cwd packages/bot estacion",
    "bot": "bun run --cwd packages/bot bot",
    "panel:dev": "bun run --cwd packages/panel dev",
    "panel:build": "bun run --cwd packages/panel build",
    "db:up": "bun run --cwd packages/db up",
    "db:migrate": "bun run --cwd packages/db migrate",
    "db:seed": "bun run --cwd packages/db seed",
    "db:status": "bun run --cwd packages/db status",
    "db:init": "bun run --cwd packages/db init",
    "extract": "bun run --cwd packages/bot extract",
    "edge:dev": "bun run --cwd packages/edge dev",
    "edge:deploy": "bun run --cwd packages/edge deploy"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "typescript": "5.8.3"
  }
}
